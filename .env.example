# ─────────────────────────────────────────────────────────
# SmartWaste AI — Environment Variables Template
# Copy this to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Model ─────────────────────────────────────────────────
# Which model to load for inference: "custom_cnn" | "resnet18"
ACTIVE_MODEL=resnet18
MODEL_DIR=./models
CONFIDENCE_THRESHOLD=0.60           # Below this → show uncertainty warning

# ── Database ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./smartwaste.db

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Optional: Kaggle API (for dataset download) ───────────
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
