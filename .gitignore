# ─────────────────────────────────────────────────────────
# SmartWaste AI — .gitignore
# ─────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
*.spec

# ── Virtual environments ──────────────────────────────────
venv/
.venv/
env/
ENV/
.env/

# ── Environment secrets ───────────────────────────────────
.env
*.local

# ── Jupyter / IPython ─────────────────────────────────────
.ipynb_checkpoints/
*.ipynb~
profile_default/
ipython_config.py

# ── PyTorch model checkpoints (large binary files) ───────
models/*.pth
models/*.pt
models/*.ckpt
models/*.bin

# ── Dataset raw/processed images (large, downloaded) ─────
dataset/raw/
dataset/processed/

# ── Training outputs ─────────────────────────────────────
results/graphs/*.png
results/confusion_matrix/*.png
results/reports/*.json
results/reports/*.csv

# ── Database ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ─────────────────────────────────────────────────
*.log
logs/

# ── Coverage / testing ───────────────────────────────────
.coverage
.pytest_cache/
htmlcov/
.tox/

# ── Node / Frontend ───────────────────────────────────────
node_modules/
frontend/dist/
frontend/.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── IDE / OS ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────
*.pid

# ── Misc ─────────────────────────────────────────────────
*.bak
*.tmp
temp/
